www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	header Strict-Transport-Security "max-age=63072000"

	# gzip would buffer the event stream, so it gets its own unbuffered proxy
	handle /api/live {
		reverse_proxy app:3000 {
			flush_interval -1
		}
	}

	handle {
		encode gzip
		reverse_proxy app:3000
	}
}
