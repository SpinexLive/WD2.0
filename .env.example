DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Token of the EXISTING REMNANT bot application (the dashboard calls Discord's REST API as that bot; no second bot is created)
DISCORD_BOT_TOKEN=
# Application public key; required for the Confirm/Decline buttons (set the Interactions Endpoint URL to APP_URL/api/discord/interactions)
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=1332320879073296404
# Optional: permanent Discord invite shown as "Join our Discord" on the public landing page
# DISCORD_INVITE_URL=https://discord.gg/xxxx

DISCORD_ALLOWED_ROLE_IDS=1349704360816414762,1546188874986950758
DISCORD_MEMBER_ROLE_ID=1546184733174669424
# Whole-clan role (all REMNANT members, not just Wardogs players); public landing member count
DISCORD_CLAN_ROLE_ID=1433399320903815188

RAID_HELPER_API_TOKEN=
WARDOGS_API_KEY=
TOURNAMENT_API_KEY=
# Direct game-server RCON HTTP API (faster than the hosted API, which is used as a fallback)
GAME_RCON_URL=
GAME_RCON_PASSWORD=

DATABASE_URL=postgres://user:password@localhost:5432/remnant
# Long random string (>= 32 chars), e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Docker deployment only (docker-compose.yml): public hostname (no scheme) and the Postgres password
# DOMAIN=dash.example.com
# POSTGRES_PASSWORD=
# Public base URL, no trailing slash. Discord redirect URI = APP_URL/welcome/discord (compose sets it from DOMAIN)
APP_URL=http://localhost:3000

# Optional overrides (see README "Raid Helper API verification")
# RAID_HELPER_BASE_URL=https://raid-helper.dev
# RAID_HELPER_EVENTS_PATH=/api/v4/servers/{guildId}/events
# RAID_HELPER_EVENT_PATH=/api/v4/events/{eventId}
# WARDOGS_RCON_SERVER_ID=
